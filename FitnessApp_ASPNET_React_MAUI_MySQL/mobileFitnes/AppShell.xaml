<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="mobileFitnes.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:mobileFitnes"
    Title="mobileFitnes"
    Shell.FlyoutBehavior="Disabled">

    <ShellContent
        ContentTemplate="{DataTemplate local:LoginPage}"
        Route="login" />

    <TabBar Route="main">
        <Tab Title="Strona główna" Route="all_classes" Icon="home_vec.png">
            <ShellContent ContentTemplate="{DataTemplate local:MainPage}"
                          Route="all" Icon="home_vec.png"/>
        </Tab>

        <Tab Title="Moje zajęcia" Route="my_classes" Icon="menu_vec.png">
            <ShellContent ContentTemplate="{DataTemplate local:MainPage}"
                          Route="my" Icon="menu_vec.png"/>
        </Tab>
    </TabBar>

</Shell>
